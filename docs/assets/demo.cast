[8.502, "o", "Skeleton \u001b[1mweekly-report\u001b[0m  \u001b[1m(\u001b[0m\u001b[1;36m3\u001b[0m traces · \u001b[1;36m7\u001b[0m steps · \u001b[1;36m1\u001b[0m judgment · \u001b[1;36m1\u001b[0m transform-needed · \u001b[1;36m2\u001b[0m pruned\u001b[1m)\u001b[0m\r\n"]
[8.502, "o", "\u001b[1m#\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mtool                        \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mkind                   \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mprovenance                           \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m in\u001b[0m\r\n"]
[8.502, "o", "1  shop.week_range               deterministic            week ← Input(week)                     3/3\r\n"]
[8.502, "o", "2  shop.week_range               transform-needed         week ← Unknown(transform)              3/3\r\n"]
[8.502, "o", "3  shop.list_orders              deterministic · observe  since ← Ref(0,$.start) · until ←       3/3\r\n"]
[8.502, "o", "                                                          Ref(0,$.end)                              \r\n"]
[8.502, "o", "4  shop.rfm_snapshot             deterministic · observe  as_of ← Ref(0,$.end)                   3/3\r\n"]
[8.502, "o", "5  shop.rfm_snapshot             deterministic · observe  as_of ← Ref(1,$.end)                   3/3\r\n"]
[8.502, "o", "6  shop.top_products             deterministic · observe  n ← Const(5) · since ← Ref(0,$.start)  3/3\r\n"]
[8.502, "o", "                                                          · until ← Ref(0,$.end)                    \r\n"]
[8.502, "o", "7  slack.post_message \u001b[2m# write\u001b[0m    judgment                 channel ← Unknown(judgment) · text ←   3/3\r\n"]
[8.502, "o", "                                                          Unknown(judgment)                         \r\n"]
